# Tessera local configuration. Copy to .env — every service reads it at boot.
# Real environment variables always win over this file.

# ── Databases (one per service; same PostgreSQL instance locally) ─────────────
INVENTORY_DATABASE_URL=postgresql://tessera:tessera@localhost:5432/inventory
RESERVATION_DATABASE_URL=postgresql://tessera:tessera@localhost:5432/reservation
PAYMENT_DATABASE_URL=postgresql://tessera:tessera@localhost:5432/payment
RECONCILIATION_DATABASE_URL=postgresql://tessera:tessera@localhost:5432/reconciliation
NOTIFICATION_DATABASE_URL=postgresql://tessera:tessera@localhost:5432/notification
DISCOVERY_DATABASE_URL=postgresql://tessera:tessera@localhost:5432/discovery

# ── Infrastructure ────────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200

# ── Service addresses ─────────────────────────────────────────────────────────
INVENTORY_URL=http://localhost:4001
RESERVATION_URL=http://localhost:4002
PAYMENT_URL=http://localhost:4003
RECONCILIATION_URL=http://localhost:4004
NOTIFICATION_URL=http://localhost:4005
DISCOVERY_URL=http://localhost:4006

# ── Secrets. Development values only; production refuses to start with them. ─
INTERNAL_TOKEN=dev-internal-token
JWT_SECRET=dev-jwt-secret
WAITING_ROOM_SECRET=dev-waiting-room-secret
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret

# ── Behaviour ─────────────────────────────────────────────────────────────────
# ok | decline | timeout_after_success | timeout_before_success | slow |
# error_after_success | duplicate_webhook | out_of_order_webhook
PAYMENT_PROVIDER_MODE=ok
WAITING_ROOM_ENABLED=false

# Tracing: set to http://localhost:4319 after `npm run up:obs` to send traces to Jaeger.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Deterministic failure injection for the chaos suite. NEVER in production.
FAILPOINTS_ENABLED=true
LOG_LEVEL=info
