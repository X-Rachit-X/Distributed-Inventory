# Settings for docker-compose.prod.yml.
#
#   cp deploy/compose/prod.env.example deploy/compose/.env
#
# Compose reads `.env` from the directory of the compose file, so it must sit
# next to docker-compose.prod.yml. It is git-ignored: never commit it.
#
# Generate every secret below with:   openssl rand -hex 32
# (hex only: the Postgres password is embedded in connection URLs, where
#  characters like @ / : # would break parsing.)

# ── Secrets (required; the stack refuses to start without them) ───────────────
POSTGRES_PASSWORD=
INTERNAL_TOKEN=
JWT_SECRET=
WAITING_ROOM_SECRET=
PAYMENT_WEBHOOK_SECRET=

# Sign-in has no password: whoever types one of these addresses becomes an
# OPERATOR (can block seats, run reconciliation, switch the payment fault mode).
# Treat it like a password: something nobody would guess, e.g.
#   ops-3f9c1a7e@your-domain.com
# The gateway refuses the public default (ops@tessera.dev) in production.
OPERATOR_EMAILS=

# ── Public address ────────────────────────────────────────────────────────────
# ":80"                  → plain HTTP on the server's IP (first deploy)
# "tessera.example.com"  → automatic HTTPS via Let's Encrypt (DNS must point here)
SITE_ADDRESS=:80

# ── Optional ──────────────────────────────────────────────────────────────────
# Full-text search with Elasticsearch (adds ~1 GB RAM). Also start the profile:
#   docker compose -f deploy/compose/docker-compose.prod.yml --profile search up -d
# Leave empty to search with the PostgreSQL fallback.
ELASTICSEARCH_URL=

# Put a waiting room in front of bookings during a flash sale.
WAITING_ROOM_ENABLED=false

# Pull prebuilt images instead of building on the server (see the guide, Level 3).
# TESSERA_IMAGE=ghcr.io/<you>/tessera-service:latest
# TESSERA_EDGE_IMAGE=ghcr.io/<you>/tessera-edge:latest

LOG_LEVEL=info
