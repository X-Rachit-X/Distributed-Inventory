  {
   "type": "stat",
   "title": "Oversells (I1+I2)",
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "tessera-prom"
   },
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(tessera_invariant_violations{invariant=~\"I1_.*|I2_.*\"}) or vector(0)",
     "refId": "A"
    }
   ]
  },
