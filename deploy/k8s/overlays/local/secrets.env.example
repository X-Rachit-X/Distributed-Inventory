# Copy to secrets.env (git-ignored). Values for a LOCAL cluster only.
# Generate real values with: openssl rand -hex 32
INTERNAL_TOKEN=change-me-internal-token
JWT_SECRET=change-me-jwt-secret
WAITING_ROOM_SECRET=change-me-waiting-room-secret
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret
OPERATOR_EMAILS=ops-local@example.com
# Must match deploy/k8s/infra/secrets.env (POSTGRES_PASSWORD).
INVENTORY_DATABASE_URL=postgresql://tessera:change-me-pg@postgres.tessera-infra.svc:5432/inventory
RESERVATION_DATABASE_URL=postgresql://tessera:change-me-pg@postgres.tessera-infra.svc:5432/reservation
PAYMENT_DATABASE_URL=postgresql://tessera:change-me-pg@postgres.tessera-infra.svc:5432/payment
RECONCILIATION_DATABASE_URL=postgresql://tessera:change-me-pg@postgres.tessera-infra.svc:5432/reconciliation
NOTIFICATION_DATABASE_URL=postgresql://tessera:change-me-pg@postgres.tessera-infra.svc:5432/notification
DISCOVERY_DATABASE_URL=postgresql://tessera:change-me-pg@postgres.tessera-infra.svc:5432/discovery
